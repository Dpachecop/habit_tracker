{
  "@@locale": "en",

  "appTitle": "Habit Tracker",
  "@appTitle": {
    "description": "Product name, shown in the OS task switcher."
  },

  "homeTitle": "Habits",
  "@homeTitle": {
    "description": "Title of the main panel listing every habit."
  },
  "homeEmpty": "No habits yet.",
  "@homeEmpty": {
    "description": "Shown on the main panel when the user has created nothing."
  },

  "errorNetwork": "No connection. Your changes will sync once you are back online.",
  "@errorNetwork": {
    "description": "Failure code 'network'. Reassuring rather than alarming: offline writes are queued, not lost."
  },
  "errorNotFound": "We could not find that.",
  "@errorNotFound": {
    "description": "Failure code 'not_found'."
  },
  "errorPermission": "You do not have access to that.",
  "@errorPermission": {
    "description": "Failure code 'permission'."
  },
  "errorCache": "The data stored on this device could not be read.",
  "@errorCache": {
    "description": "Failure code 'cache'."
  },
  "errorUnknown": "Something went wrong.",
  "@errorUnknown": {
    "description": "Failure code 'unknown'. Deliberately vague — the detail goes to the log, not to the user."
  },

  "errorCompletionArchived": "This habit is archived.",
  "@errorCompletionArchived": {
    "description": "Failure code 'completion.archived'."
  },
  "errorCompletionOutsideRange": "That day falls outside the habit's date range.",
  "@errorCompletionOutsideRange": {
    "description": "Failure code 'completion.outside_range'."
  },
  "errorCompletionFutureDate": "You cannot check off a day that has not happened yet.",
  "@errorCompletionFutureDate": {
    "description": "Failure code 'completion.future_date'."
  },
  "errorCompletionAlreadyRecorded": "You already checked this day off.",
  "@errorCompletionAlreadyRecorded": {
    "description": "Failure code 'completion.already_recorded'."
  },
  "errorCompletionNotScheduled": "This habit is not scheduled for that day.",
  "@errorCompletionNotScheduled": {
    "description": "Failure code 'completion.not_scheduled'. The no-over-completion rule, ARCHITECTURE.md 3.5."
  },
  "errorCompletionQuotaReached": "You have already met this period's goal.",
  "@errorCompletionQuotaReached": {
    "description": "Failure code 'completion.quota_reached'. The no-over-completion rule, ARCHITECTURE.md 3.5."
  },

  "checkDisabledNotToday": "Not today",
  "@checkDisabledNotToday": {
    "description": "Short label under a disabled check button when the habit is not due today."
  },
  "quotaProgressWeek": "{completed}/{target} this week",
  "@quotaProgressWeek": {
    "description": "Progress within the current week for an N-times-per-period habit.",
    "placeholders": {
      "completed": { "type": "int" },
      "target": { "type": "int" }
    }
  },
  "quotaProgressMonth": "{completed}/{target} this month",
  "@quotaProgressMonth": {
    "description": "Progress within the current month for an N-times-per-period habit.",
    "placeholders": {
      "completed": { "type": "int" },
      "target": { "type": "int" }
    }
  },
  "quotaProgressYear": "{completed}/{target} this year",
  "@quotaProgressYear": {
    "description": "Progress within the current year for an N-times-per-period habit.",
    "placeholders": {
      "completed": { "type": "int" },
      "target": { "type": "int" }
    }
  },

  "homeGreetingMorning": "Good morning.",
  "@homeGreetingMorning": {
    "description": "Greeting on the home header before noon. No name: the account is anonymous until the last phase, and 'Good morning, null' is worse than no name at all."
  },
  "homeGreetingAfternoon": "Good afternoon.",
  "@homeGreetingAfternoon": { "description": "Greeting between noon and 19h." },
  "homeGreetingEvening": "Good evening.",
  "@homeGreetingEvening": { "description": "Greeting from 19h onwards." },

  "homeHabitsLeft": "{count, plural, =0{Nothing left for today. Well done.} =1{You have 1 habit left to complete today.} other{You have {count} habits left to complete today.}}",
  "@homeHabitsLeft": {
    "description": "Summary under the greeting. Counts only habits that are due today and still uncompleted.",
    "placeholders": { "count": { "type": "int" } }
  },
  "homeNothingDueToday": "Nothing is scheduled for today.",
  "@homeNothingDueToday": {
    "description": "Shown instead of the count when the user has habits but none of them fall on today."
  },
  "homeEmptyHint": "Create your first goal to start a streak.",
  "@homeEmptyHint": {
    "description": "Second line of the empty state, under homeEmpty."
  },

  "streakDays": "{count, plural, =1{1 day streak} other{{count} day streak}}",
  "@streakDays": {
    "description": "Streak label on a habit card. Counts completed days, not periods.",
    "placeholders": { "count": { "type": "int" } }
  },
  "streakNone": "No streak yet",
  "@streakNone": {
    "description": "Shown in place of streakDays when the current streak is zero."
  },

  "scheduleDaily": "Daily",
  "@scheduleDaily": {
    "description": "Schedule label for SpecificWeekdays covering all seven days."
  },
  "scheduleTimesPerWeek": "{times, plural, =1{Once a week} =2{Twice a week} other{{times} times a week}}",
  "@scheduleTimesPerWeek": {
    "description": "Schedule label for TimesPerPeriod over a week. Distinct from a weekday list on purpose: here the user picks which days, and that is a different goal.",
    "placeholders": { "times": { "type": "int" } }
  },
  "scheduleTimesPerMonth": "{times, plural, =1{Once a month} =2{Twice a month} other{{times} times a month}}",
  "@scheduleTimesPerMonth": {
    "description": "Schedule label for TimesPerPeriod over a month.",
    "placeholders": { "times": { "type": "int" } }
  },
  "scheduleTimesPerYear": "{times, plural, =1{Once a year} =2{Twice a year} other{{times} times a year}}",
  "@scheduleTimesPerYear": {
    "description": "Schedule label for TimesPerPeriod over a year.",
    "placeholders": { "times": { "type": "int" } }
  },

  "navHome": "Home",
  "@navHome": { "description": "Bottom navigation label." },
  "navAnalytics": "Analytics",
  "@navAnalytics": { "description": "Bottom navigation label." },
  "navSettings": "Settings",
  "@navSettings": { "description": "Bottom navigation label." },
  "navProfile": "Profile",
  "@navProfile": { "description": "Bottom navigation label." },
  "comingSoon": "Coming soon.",
  "@comingSoon": {
    "description": "Placeholder body for tabs whose phase has not been built yet."
  },

  "categoryHealth": "Health",
  "@categoryHealth": { "description": "HabitCategory.health" },
  "categoryFitness": "Fitness",
  "@categoryFitness": { "description": "HabitCategory.fitness" },
  "categoryMind": "Mind",
  "@categoryMind": { "description": "HabitCategory.mind" },
  "categoryLearning": "Learning",
  "@categoryLearning": { "description": "HabitCategory.learning" },
  "categoryWork": "Work",
  "@categoryWork": { "description": "HabitCategory.work" },
  "categoryFinance": "Finance",
  "@categoryFinance": { "description": "HabitCategory.finance" },
  "categorySocial": "Social",
  "@categorySocial": { "description": "HabitCategory.social" },
  "categoryHome": "Home",
  "@categoryHome": { "description": "HabitCategory.home" },
  "categoryCreativity": "Creativity",
  "@categoryCreativity": { "description": "HabitCategory.creativity" },
  "categoryOther": "Other",
  "@categoryOther": { "description": "HabitCategory.other" }
