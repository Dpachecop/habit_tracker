  "@formUnreachableWeek": {
    "description": "The 3.4 warning for a weekly target. Burning a streak in silence is not acceptable, so the user is told and decides.",
    "placeholders": { "missing": { "type": "int" }, "daysLeft": { "type": "int" } }
